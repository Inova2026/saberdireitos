---
// src/components/Header.astro
---

<header class="site-header">
  <div class="header-container">
    <!-- Logotipo Tipográfico -->
    <a href="/" class="logo">
      <span class="logo-highlight">Saber</span> Direitos
    </a>

    <!-- Menu de Categorias -->
    <nav class="main-nav">
      <ul>
        <li><a href="/categoria/inss">INSS</a></li>
        <li><a href="/categoria/fgts">FGTS</a></li>
        <li><a href="/categoria/trabalho">Trabalho (CLT)</a></li>
        <li><a href="/sobre">Sobre</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background-color: #ffffff;
    border-bottom: 2px solid #e2e8f0;
    padding: 1.2rem 0;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }
  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }
  .logo {
    font-size: 2rem;
    font-weight: 800;
    text-decoration: none;
    color: #1e293b;
    letter-spacing: -0.5px;
  }
  .logo-highlight {
    color: #2563eb; /* Azul forte e institucional */
  }
  .main-nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }
  .main-nav a {
    text-decoration: none;
    color: #475569;
    font-weight: 600;
    font-size: 1rem;
    transition: color 0.2s ease-in-out;
  }
  .main-nav a:hover {
    color: #2563eb;
  }

  /* Responsividade para celulares */
  @media (max-width: 768px) {
    .header-container {
      flex-direction: column;
      gap: 1rem;
    }
    .main-nav ul {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
